# btop TTY绿色主题 - 荧光绿色系
# 仅用于TTY环境

# Main background, empty for terminal default
theme[main_bg]="#001100"

# Main text color
theme[main_fg]="#33ff33"

# Title color for boxes
theme[title]="#33ff33"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#66ff66"

# Background color of selected item in processes box
theme[selected_bg]="#003300"

# Foreground color of selected item in processes box
theme[selected_fg]="#99ff99"

# Color of inactive/disabled text
theme[inactive_fg]="#006600"

# Color of text appearing on top of graphs
theme[graph_text]="#66ff66"

# Background color of the percentage meters
theme[meter_bg]="#002200"

# Misc colors for processes box
theme[proc_misc]="#33ff33"

# CPU colors
theme[cpuonica]="#33ff33"
theme[cpuonb]="#66ff66"
theme[cpuonna]="#99ff99"
theme[cpuonbb]="#33ff33"

# Memory
theme[mem]="#33ff33"
theme[mem_bg]="#001100"

# Disk
theme[.disk]="#33ff33"
theme[net]="#33ff33"
theme[updown]="#66ff66"

# Graph gradient colors
theme[cpu_other_first]="#003300"
theme[cpu_other_mid]="#006600"
theme[cpu_other_last]="#33ff33"
theme[cpu_first]="#33ff33"
theme[cpu_mid]="#66ff66"
theme[cpu_last]="#99ff99"
theme[mem_other_first]="#003300"
theme[mem_other_mid]="#006600"
theme[mem_other_last]="#33ff33"
theme[mem_first]="#33ff33"
theme[mem_mid]="#66ff66"
theme[mem_last]="#99ff99"

# Free disk
theme[free_disk]="#33ff33"
