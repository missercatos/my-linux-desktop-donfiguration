#!/usr/bin/env python3
"""
generate-starship-dms.py
Dynamically generate starship.toml based on current DMS theme
"""

import json
import os
import sys

STARSHIP_CONFIG = os.path.expanduser("~/.config/tactical/starship.toml")
DMS_THEMES_DIR = os.path.expanduser("~/.config/DankMaterialShell/themes")
DMS_SETTINGS = os.path.expanduser("~/.config/DankMaterialShell/settings.json")

def get_current_theme():
    """Get current DMS theme name from settings.json"""
    try:
        with open(DMS_SETTINGS, 'r') as f:
            settings = json.load(f)
        
        custom_file = settings.get('customThemeFile', '')
        if custom_file:
            # Extract theme name from path: .../themes/milkTheme/theme.json
            parts = custom_file.split('/')
            if 'themes' in parts:
                idx = parts.index('themes')
                if idx + 1 < len(parts):
                    return parts[idx + 1]
        
        return "tokyoNight"
    except (FileNotFoundError, json.JSONDecodeError):
        return "tokyoNight"

def get_theme_colors(theme_name):
    """Extract colors from theme.json"""
    theme_file = os.path.join(DMS_THEMES_DIR, theme_name, "theme.json")
    try:
        with open(theme_file, 'r') as f:
            theme = json.load(f)
        dark = theme.get('dark', {})
        return {
            'primary': dark.get('primary', '#7aa2f7'),
            'secondary': dark.get('secondary', '#bb9af7'),
            'tertiary': dark.get('surfaceTint', '#7dcfff'),
            'error': dark.get('error', '#f7768e'),
            'warning': dark.get('warning', '#ff9e64'),
            'info': dark.get('info', '#7dcfff'),
            'surface': dark.get('surfaceText', '#c0caf5'),
        }
    except FileNotFoundError:
        print(f"Theme file not found: {theme_file}", file=sys.stderr)
        sys.exit(1)

def generate_starship_config(theme_name, colors):
    """Generate starship.toml content"""
    return f'''# tactical/starship.toml
# Auto-generated from DMS theme: {theme_name}
# DO NOT EDIT - Regenerate with: generate-starship-dms

format = \'\'\'
┌──(\\[$username\\]@\\[$hostname\\])─\\[$directory\\]─$time $git_branch$git_status $c$cpp$dart$deno$elixir$golang$haskell$java$julia$kotlin$lua$nodejs$perl$php$python$rlang$ruby$rust$scala$swift$zig
└─$character\'\'\'

add_newline = true

palette = 'dms'

[palettes.dms]
primary = '{colors["primary"]}'
secondary = '{colors["secondary"]}'
tertiary = '{colors["tertiary"]}'
error = '{colors["error"]}'
warning = '{colors["warning"]}'
info = '{colors["info"]}'
surface = '{colors["surface"]}'

[username]
show_always = true
format = "[$user]($style)"
style_user = "bold fg:tertiary"
style_root = "bold fg:error"

[hostname]
format = "[$hostname]($style)"
style = "bold fg:surface"
ssh_only = false
trim_at = ""

[directory]
format = "[$path]($style)[$read_only]($style)"
style = "bold fg:secondary"
truncation_length = 3
truncation_symbol = ""
read_only = ""

[directory.substitutions]
"Documents" = ""
"Downloads" = ""
"Music" = ""
"Pictures" = ""
"Videos" = ""
"Developer" = ""
".local/share" = ""

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vicmd_symbol = "[❮](bold fg:warning)"

[time]
disabled = false
format = "at $time($style)"
time_format = "%R"
style = "bold fg:surface"

[git_branch]
format = "[$symbol$branch]($style) "
symbol = "\\uf418"
style = "bold fg:primary"

[git_status]
format = \'(\\[$all_status$ahead_behind\\] )\'
style = "bold fg:error"
ahead = "⇡${{count}}"
behind = "⇣${{count}}"
diverged = "⇡${{ahead_count}}⇣${{behind_count}}"
conflicted = "="
untracked = "?"
stashed = "*"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"

[nodejs]
format = "[$symbol($version)]($style) "
symbol = "\\ue718"
version_format = "v$raw"
style = "bold fg:primary"

[python]
format = "[$symbol($version)]($style) "
symbol = "\\ue235"
version_format = "v$raw"
style = "bold fg:tertiary"

[c]
format = "[$symbol($version)]($style) "
symbol = "\\ue61e"
version_format = "v$raw"
style = "bold fg:primary"

[cpp]
format = "[$symbol($version)]($style) "
symbol = "\\ue61d"
version_format = "v$raw"
style = "bold fg:primary"

[golang]
format = "[$symbol($version)]($style) "
symbol = "\\ue627"
version_format = "v$raw"
style = "bold fg:secondary"

[rust]
format = "[$symbol($version)]($style) "
symbol = "\\uf1617"
version_format = "v$raw"
style = "bold fg:error"

[dart]
format = "[$symbol($version)]($style) "
symbol = "\\ue64c"
version_format = "v$raw"
style = "bold fg:secondary"

[deno]
format = "[$symbol($version)]($style) "
symbol = "\\ue7c0"
version_format = "v$raw"
style = "bold fg:secondary"

[elixir]
format = "[$symbol($version)]($style) "
symbol = "\\ue62d"
version_format = "v$raw"
style = "bold fg:secondary"

[haskell]
format = "[$symbol($version)]($style) "
symbol = "\\ue777"
version_format = "v$raw"
style = "bold fg:tertiary"

[java]
format = "[$symbol($version)]($style) "
symbol = "\\ue738"
version_format = "v$raw"
style = "bold fg:error"

[julia]
format = "[$symbol($version)]($style) "
symbol = "\\ue624"
version_format = "v$raw"
style = "bold fg:tertiary"

[kotlin]
format = "[$symbol($version)]($style) "
symbol = "\\ue634"
version_format = "v$raw"
style = "bold fg:tertiary"

[lua]
format = "[$symbol($version)]($style) "
symbol = "\\ue620"
version_format = "v$raw"
style = "bold fg:secondary"

[perl]
format = "[$symbol($version)]($style) "
symbol = "\\ue67e"
version_format = "v$raw"
style = "bold fg:secondary"

[php]
format = "[$symbol($version)]($style) "
symbol = "\\ue608"
version_format = "v$raw"
style = "bold fg:tertiary"

[rlang]
format = "[$symbol($version)]($style) "
symbol = "\\uf07d4"
version_format = "v$raw"
style = "bold fg:secondary"

[ruby]
format = "[$symbol($version)]($style) "
symbol = "\\ue791"
version_format = "v$raw"
style = "bold fg:error"

[scala]
format = "[$symbol($version)]($style) "
symbol = "\\ue737"
version_format = "v$raw"
style = "bold fg:error"

[swift]
format = "[$symbol($version)]($style) "
symbol = "\\ue755"
version_format = "v$raw"
style = "bold fg:primary"

[zig]
format = "[$symbol($version)]($style) "
symbol = "\\ue6a9"
version_format = "v$raw"
style = "bold fg:warning"
'''

def main():
    theme_name = get_current_theme()
    colors = get_theme_colors(theme_name)
    content = generate_starship_config(theme_name, colors)
    
    with open(STARSHIP_CONFIG, 'w', encoding='utf-8') as f:
        f.write(content)

if __name__ == "__main__":
    main()
