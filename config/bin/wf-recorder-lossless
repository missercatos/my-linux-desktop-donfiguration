#!/bin/bash
# 高质量录屏：60fps，无损 ffv1（高质量视频格式 .mkv）
# 系统音频：自动跟随当前默认输出设备的 monitor（清晰，避免蓝牙麦克风糊声）
REC_DIR="$HOME/Videos"
mkdir -p "$REC_DIR"

SRC="$HOME/.local/bin/wf-record-audio-source"
AUDIO_DEVICE=""
[[ -x "$SRC" ]] && AUDIO_DEVICE="$("$SRC")"

stop_rec() {
    local i
    for i in $(seq 1 40); do
        pgrep -x wf-recorder >/dev/null || break
        sleep 0.5
    done
    notify-send "录制已保存" "$REC_DIR/"
}

if pgrep -x wf-recorder > /dev/null; then
    killall -SIGINT wf-recorder
    stop_rec
else
    FILE="$REC_DIR/high_$(date +%s).mkv"
    if [[ -n "$AUDIO_DEVICE" ]]; then
        wf-recorder --audio="$AUDIO_DEVICE" -c ffv1 -r 60 -f "$FILE" &
    else
        wf-recorder -a -c ffv1 -r 60 -f "$FILE" &
    fi
    sleep 1
    if pgrep -x wf-recorder > /dev/null; then
        notify-send "高质量录制中 (无损 60fps)" "$FILE"
    else
        notify-send "录制失败" "请检查音频设备"
    fi
fi
