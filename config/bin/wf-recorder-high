#!/bin/bash
# 高质量录屏：60fps，H.264 CRF14 full-range (黑纯黑, 观感舒适)
# 系统音频：自动跟随当前默认输出设备的 monitor
# 与 wf-recorder-quick 互不干扰：各自用独立 pidfile，只控制自己的录制
REC_DIR="$HOME/Videos"
mkdir -p "$REC_DIR"

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$UID}"
MY_PID="$RUNTIME/wfrec-high.pid"
OTHER_PID="$RUNTIME/wfrec-quick.pid"

SRC="$HOME/.local/bin/wf-record-audio-source"
AUDIO_DEVICE=""
[[ -x "$SRC" ]] && AUDIO_DEVICE="$("$SRC")"

is_my_rec() { [[ -f "$MY_PID" ]] && kill -0 "$(cat "$MY_PID" 2>/dev/null)" 2>/dev/null; }
other_rec() { [[ -f "$OTHER_PID" ]] && kill -0 "$(cat "$OTHER_PID" 2>/dev/null)" 2>/dev/null; }
clean_my_pid() { rm -f "$MY_PID"; }

if is_my_rec; then
    kill -INT "$(cat "$MY_PID")" 2>/dev/null
    local i
    for i in $(seq 1 40); do is_my_rec || break; sleep 0.5; done
    clean_my_pid
    notify-send "录制已保存" "$REC_DIR/"
    exit 0
fi

# 另一档(快速)正在录制时，不顶掉它
if other_rec; then
    notify-send "录屏冲突" "快速录屏正在进行，请先停止 (Mod+Ctrl+R)"
    exit 0
fi

# 清理陈旧 pidfile
clean_my_pid

FILE="$REC_DIR/high_$(date +%s).mp4"
# full-range 转换: 黑=纯黑不抬灰; 4:2:0 使荧光绿字略暗但整体观感好
COLOR_ARGS=( -p "colorspace=bt709" -p "color_primaries=bt709" -p "color_trc=bt709" -p "color_range=pc" )
if [[ -n "$AUDIO_DEVICE" ]]; then
    wf-recorder --audio="$AUDIO_DEVICE" \
        -c libx264 -r 60 -p crf=14 -p preset=fast \
        "${COLOR_ARGS[@]}" \
        -F "scale=in_range=full:out_range=full,format=yuv420p" \
        -f "$FILE" &
else
    wf-recorder -a -c libx264 -r 60 -p crf=14 -p preset=fast \
        "${COLOR_ARGS[@]}" \
        -F "scale=in_range=full:out_range=full,format=yuv420p" \
        -f "$FILE" &
fi
echo $! > "$MY_PID"
sleep 1
if is_my_rec; then
    notify-send "高质量录制中 (60fps H.264)" "$FILE"
else
    clean_my_pid
    notify-send "录制失败" "请检查音频设备"
fi
