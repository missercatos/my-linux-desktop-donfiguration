#!/bin/bash
# 快速录屏：60fps，无损 ffv1（高质量视频格式 .mkv），系统音频
REC_DIR="$HOME/Videos"
mkdir -p "$REC_DIR"

if pgrep -x wf-recorder > /dev/null; then
    killall -SIGINT wf-recorder
    notify-send "录制已保存" "$REC_DIR/"
else
    FILE="$REC_DIR/quick_$(date +%s).mkv"
    wf-recorder -a -c ffv1 -r 60 -f "$FILE" &
    sleep 1
    if pgrep -x wf-recorder > /dev/null; then
        notify-send "快速录制中 (无损 60fps)" "$FILE"
    else
        notify-send "录制失败" "请检查音频设备"
    fi
fi
