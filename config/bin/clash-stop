#!/bin/bash
# Clash 停止脚本
# 停止clash并清除代理环境变量

# 停止clash进程
pkill -x clash 2>/dev/null

# 清除环境变量配置文件
rm -f ~/.config/environment.d/clash-global.conf
rm -f ~/.config/environment.d/clash-browser.conf

# 清除当前终端的代理环境变量
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY

echo "✓ Clash 已停止"
echo "  代理环境变量已清除"
echo ""
echo "  新终端将不再使用代理"
echo "  当前终端请执行: unset http_proxy https_proxy all_proxy"
