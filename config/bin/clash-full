#!/bin/bash
# Clash 全局加速模式
# 启动终端和浏览器全体代理

CLASH_PORT="${CLASH_PORT:-7890}"
CLASH_SOCKS="${CLASH_SOCKS:-7890}"

# 停止已有clash进程
pkill -x clash 2>/dev/null
sleep 1

# 启动clash（混合端口模式，支持HTTP和SOCKS5）
if command -v clash &>/dev/null; then
    clash -d "$HOME/.config/mihomo" &
elif [[ -f "$HOME/.local/bin/clash" ]]; then
    "$HOME/.local/bin/clash" &
elif [[ -f "$HOME/clash/clash" ]]; then
    "$HOME/clash/clash" -d "$HOME/clash" &
else
    echo "错误: 未找到clash"
    exit 1
fi

sleep 2

# 设置全局代理环境变量
export http_proxy="http://127.0.0.1:$CLASH_PORT"
export https_proxy="http://127.0.0.1:$CLASH_PORT"
export all_proxy="socks5://127.0.0.1:$CLASH_SOCKS"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"

# 写入环境变量到profile
mkdir -p ~/.config/environment.d
cat > ~/.config/environment.d/clash-global.conf << EOF
# Clash Global Proxy (auto-generated)
http_proxy=http://127.0.0.1:$CLASH_PORT
https_proxy=http://127.0.0.1:$CLASH_PORT
all_proxy=socks5://127.0.0.1:$CLASH_SOCKS
HTTP_PROXY=http://127.0.0.1:$CLASH_PORT
HTTPS_PROXY=http://127.0.0.1:$CLASH_PORT
ALL_PROXY=socks5://127.0.0.1:$CLASH_SOCKS
no_proxy=localhost,127.0.0.1,::1
EOF

echo "✓ Clash 全局加速已启动"
echo "  HTTP代理: http://127.0.0.1:$CLASH_PORT"
echo "  SOCKS5:   socks5://127.0.0.1:$CLASH_SOCKS"
echo ""
echo "  新终端将自动使用代理"
echo "  当前终端请执行: source ~/.config/environment.d/clash-global.conf"
