#!/bin/bash
# Clash 管理脚本
# 用法: clash [命令]

show_help() {
    echo "Clash 管理工具"
    echo ""
    echo "用法: clash [命令]"
    echo ""
    echo "命令:"
    echo "  full       全局加速模式（终端+浏览器）"
    echo "  terminal   终端加速模式（只加速终端）"
    echo "  browser    浏览器加速模式（只启动端口）"
    echo "  stop       停止clash并清除代理"
    echo "  status     查看clash运行状态"
    echo "  help       显示此帮助信息"
    echo ""
    echo "示例:"
    echo "  clash full       # 启动全局代理"
    echo "  clash terminal   # 只加速终端"
    echo "  clash browser    # 只启动浏览器端口"
    echo "  clash stop       # 停止代理"
    echo ""
    echo "默认端口: 7890 (HTTP/SOCKS5)"
}

show_status() {
    if pgrep -x clash > /dev/null; then
        echo "✓ Clash 正在运行"
        echo "  PID: $(pgrep -x clash)"
        echo "  端口: 7890"
        
        # 检查端口是否监听
        if ss -tlnp | grep -q ":7890"; then
            echo "  状态: 端口7890已监听"
        else
            echo "  状态: 端口7890未监听"
        fi
    else
        echo "✗ Clash 未运行"
    fi
}

case "${1:-help}" in
    full)
        ~/.local/bin/clash-full
        ;;
    terminal)
        ~/.local/bin/clash-terminal
        ;;
    browser)
        ~/.local/bin/clash-browser
        ;;
    stop)
        ~/.local/bin/clash-stop
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "未知命令: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
