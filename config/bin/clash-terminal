#!/bin/bash
# Clash 终端加速模式
# 只为当前终端设置代理，不影响浏览器

CLASH_PORT="${CLASH_PORT:-7890}"
CLASH_SOCKS="${CLASH_SOCKS:-7890}"

# 停止已有clash进程
pkill -x clash 2>/dev/null
sleep 1

# 启动clash
if command -v clash &>/dev/null; then
    clash -d "$HOME/.config/mihomo" &
elif [[ -f "$HOME/.local/bin/clash" ]]; then
    "$HOME/.local/bin/clash" &
elif [[ -f "$HOME/clash/clash" ]]; then
    "$HOME/clash/clash" -d "$HOME/clash" &
else
    echo "错误: 未找到clash"
    exit 1
fi

sleep 2

# 只设置当前终端的代理环境变量
export http_proxy="http://127.0.0.1:$CLASH_PORT"
export https_proxy="http://127.0.0.1:$CLASH_PORT"
export all_proxy="socks5://127.0.0.1:$CLASH_SOCKS"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"

echo "✓ Clash 终端加速已启动"
echo "  HTTP代理: http://127.0.0.1:$CLASH_PORT"
echo "  SOCKS5:   socks5://127.0.0.1:$CLASH_SOCKS"
echo ""
echo "  当前终端已启用代理"
echo "  浏览器需要手动设置代理: 127.0.0.1:$CLASH_PORT"
