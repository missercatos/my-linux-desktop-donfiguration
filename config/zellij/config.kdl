// zellij config - fluorescent green theme
// TTY independent config (zellij 0.45 schema)

// Theme
theme "green-tty"

// Default layout
default_layout "compact"

// Mouse support
mouse_mode true

// Pane frames
pane_frames true

// Shell / options (0.45 uses top-level keys, not an `options {}` block)
default_shell "zsh"
scroll_buffer_size 10000
copy_on_select true
live_alt_stack true
scrollback_lines_to_skip 50

// Keybindings (mode-scoped; user scheme: no Ctrl-b prefix)
keybinds {
    // Enter sub-modes from normal
    normal {
        bind "Ctrl a" { SwitchToMode "Session"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }
    session {
        bind "Ctrl o" { SwitchToMode "Normal"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
        bind "Ctrl d" { Detach; }
        bind "Ctrl q" { Quit; }
    }
    scroll {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    // Tab / window management (usable from normal and pane)
    shared_except "locked" {
        bind "Ctrl n" { NewTab; }
        bind "Alt n" { NewTab; }
        bind "Ctrl h" "Alt h" { GoToPreviousTab; }
        bind "Ctrl l" "Alt l" { GoToNextTab; }
        bind "Ctrl x" "Alt x" { CloseTab; }
    }
    // Pane management & splits
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
        bind "Alt d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "Alt r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "Ctrl z" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "Ctrl x" { CloseFocus; SwitchToMode "Normal"; }
    }
    // Keep a useful normal-mode fallback for the above too
    normal {
        bind "Alt d" { NewPane "Down"; }
        bind "Alt r" { NewPane "Right"; }
        bind "Ctrl z" { ToggleFloatingPanes; }
        bind "Ctrl q" { Quit; }
        bind "Ctrl d" { Detach; }
    }
}

// Plugins: keep the default set
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
}
