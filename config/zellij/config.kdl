# zellij config - fluorescent green theme
# TTY independent config

# Theme
theme "green-tty"

# Default layout
default_layout "compact"

# Mouse support
mouse_mode true

# Pane frames
pane_frames {
    hide_session_name false
}

# Status bar config
status_bar {
    left {
        pane {
            command "bash"
            args "-c" "while true; do echo -ne \"\033[32m$(date '+%H:%M:%S')\033[0m\"; sleep 1; done"
        }
    }
    right {
        pane {
            command "bash"
            args "-c" "while true; do BATTERY=$(acpi -b 2>/dev/null | grep -oP '\\d+%' || echo 'N/A'); echo -ne \"\033[32mBATT: ${BATTERY}\033[0m\"; sleep 1; done"
        }
    }
}

# Keybindings
keybinds {
    unbind "Ctrl b"
    
    # Window management
    bind "Ctrl a" { SwitchToMode "Session"; }
    bind "Ctrl n" { NewTab; }
    bind "Ctrl h" { GoToPreviousTab; }
    bind "Ctrl l" { GoToNextTab; }
    bind "Ctrl x" { CloseTab; }
    
    # Pane management
    bind "Ctrl d" { Detach; }
    bind "Ctrl z" { ToggleFloatingPanes; }
    
    # Split
    bind "Alt d" { NewPane "Down"; }
    bind "Alt r" { NewPane "Right"; }
    
    # Session mode
    unbind "Ctrl o"
    bind "Ctrl s" { SwitchToMode "Scroll"; }
    
    # Quick actions
    bind "Alt n" { NewTab; }
    bind "Alt h" { GoToPreviousTab; }
    bind "Alt l" { GoToNextTab; }
    bind "Alt x" { CloseTab; }
    
    # Session management
    bind "Ctrl q" { Quit; }
}

# Plugins
plugins {
    compact-bar location="zellij:compact-bar"
    status-bar location="zellij:status-bar"
}

# Layout
layout {
    pane borderless=true
    pane split_direction="vertical" {
        pane borderless=true
    }
}

# Options
options {
    default_shell "zsh"
    scroll_buffer_size 10000
    copy_on_select true
    live_alt_stack true
    scrollback_lines_to_skip 50
}
