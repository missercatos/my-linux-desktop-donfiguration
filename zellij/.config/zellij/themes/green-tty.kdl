# zellij绿色主题 - 荧光绿色系
# 用于TTY环境

themes {
    green-tty {
        bg "#001100"
        fg "#33ff33"
        black "#001100"
        red "#ff5555"
        green "#33ff33"
        yellow "#66ff66"
        blue "#33ff33"
        magenta "#99ff99"
        cyan "#33ff33"
        white "#33ff33"
        orange "#66ff33"
        purple "#99ff99"
    }
}

# 状态栏样式
keybinds {
    unbind "Ctrl b"
    bind "Ctrl a" { SwitchToMode "Session"; }
    bind "Ctrl n" { NewTab; }
    bind "Ctrl h" { GoToPreviousTab; }
    bind "Ctrl l" { GoToNextTab; }
    bind "Ctrl x" { CloseTab; }
    bind "Ctrl d" { Detach; }
    bind "Ctrl z" { ToggleFloatingPanes; }
    bind "Alt d" { NewPane "Down"; }
    bind "Alt r" { NewPane "Right"; }
    bind "Ctrl s" { SwitchToMode "Scroll"; }
    bind "Alt n" { NewTab; }
    bind "Alt h" { GoToPreviousTab; }
    bind "Alt l" { GoToNextTab; }
    bind "Alt x" { CloseTab; }
    bind "Ctrl q" { Quit; }
}
