#!/usr/bin/env bash
# Generate starship config with cava theme colors and Nerd Font language logos

CAVA_CONFIG="$HOME/.config/cava/config"
CAVA_THEME_DIR="$HOME/.config/cava/themes"
STARSHIP_CONFIG="$HOME/.config/tactical/starship.toml"

# Read cava theme
if [[ -f "$CAVA_CONFIG" ]]; then
    THEME=$(grep "theme = " "$CAVA_CONFIG" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    if [[ -n "$THEME" && -f "$CAVA_THEME_DIR/$THEME" ]]; then
        CAVA_SRC="$CAVA_THEME_DIR/$THEME"
    else
        CAVA_SRC="$CAVA_CONFIG"
    fi
else
    CAVA_SRC=""
fi

# Extract colors
if [[ -n "$CAVA_SRC" ]]; then
    COLOR1=$(grep "gradient_color_1" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR2=$(grep "gradient_color_2" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR3=$(grep "gradient_color_3" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
fi

COLOR1="${COLOR1:-#52263e}"
COLOR2="${COLOR2:-#ac3232}"
COLOR3="${COLOR3:-#e6d4d8}"

# Write starship config
cat > "$STARSHIP_CONFIG" << STARSHIP_EOF
# tactical/starship.toml - Dynamic config based on cava theme
# Auto-generated by generate-starship-config

format = """
┌──[\$username](bold fg:$COLOR2)-[\$hostname](bold fg:$COLOR3 dimmed)-[\$directory](bold fg:$COLOR1)-[\$time](bold fg:$COLOR3) \$git_branch\$git_status \$c\$cpp\$dart\$deno\$elixir\$golang\$haskell\$java\$julia\$kotlin\$lua\$nodejs\$perl\$php\$python\$rlang\$ruby\$rust\$scala\$swift\$zig
└─<\$character"""

add_newline = true

[username]
style_user = "bold fg:$COLOR3"
style_root = "bold fg:#ff0000"
show_always = true
format = "[\$user](\$style)"

[hostname]
style = "bold fg:$COLOR3 dimmed"
ssh_only = false
format = "[@\$hostname](\$style)"

[directory]
style = "bold fg:$COLOR1"
truncation_length = 5
truncate_to_repo = true
format = "[\$path](\$style) "

[time]
disabled = false
time_format = "%H:%M"
style = "bold fg:$COLOR3"
format = "at [\$time](\$style) "

[git_branch]
style = "bold fg:$COLOR2"
format = "[\$symbol\$branch](\$style) "

[git_status]
style = "bold fg:$COLOR3"
format = '[\$all_status\$ahead_behind](\$style) '

# Language modules with Nerd Font symbols
[c]
disabled = false
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[cpp]
disabled = false
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[dart]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[deno]
symbol = " "
style = "bold fg:$COLOR3"
format = "[\$symbol\$version](\$style) "

[elixir]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[golang]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[haskell]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[java]
symbol = " "
style = "bold fg:$COLOR3"
format = "[\$symbol\$version](\$style) "

[julia]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[kotlin]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[lua]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[nodejs]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[perl]
symbol = " "
style = "bold fg:$COLOR3"
format = "[\$symbol\$version](\$style) "

[php]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[python]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[rlang]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[ruby]
symbol = " "
style = "bold fg:$COLOR3"
format = "[\$symbol\$version](\$style) "

[rust]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[scala]
symbol = " "
style = "bold fg:$COLOR1"
format = "[\$symbol\$version](\$style) "

[swift]
symbol = " "
style = "bold fg:$COLOR3"
format = "[\$symbol\$version](\$style) "

[zig]
symbol = " "
style = "bold fg:$COLOR2"
format = "[\$symbol\$version](\$style) "

[character]
success_symbol = "[>](bold fg:$COLOR2)"
error_symbol = "[>](bold fg:#ff0000)"
format = "\$symbol "
STARSHIP_EOF

echo "Generated with cava gradient: $COLOR1 → $COLOR2 → $COLOR3"
