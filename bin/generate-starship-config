#!/usr/bin/env bash
# Generate starship config with DMS theme colors

python3 << 'PYEOF'
import os

# DMS milkTheme colors (from DankMaterialShell/themes/milkTheme/theme.json)
dms_colors = {
    "primary": "#ac3232",
    "primaryContainer": "#52263e",
    "surfaceText": "#e6d4d8",
    "outline": "#ac3232",
    "error": "#ac3232",
    "warning": "#d97706",
    "info": "#3b82f6",
}

# Unicode chars
pipe_tl = "\u250c"  # ┌
pipe_h  = "\u2500"  # ─
pipe_bl = "\u2514"  # └

# Language modules with official brand colors
langs = [
    ("c", "C", "#A8B9CC"),
    ("cpp", "C++", "#00599C"),
    ("dart", "\u25B2", "#0175C2"),
    ("deno", "D", "#010101"),
    ("elixir", "\u2618", "#6E4A7E"),
    ("golang", "Go", "#00ADD8"),
    ("haskell", "\u03BB", "#5e5086"),
    ("java", "J", "#ED8B00"),
    ("julia", "\u2248", "#9558B2"),
    ("kotlin", "K", "#7F52FF"),
    ("lua", "\u2615", "#000080"),
    ("nodejs", "\u2714", "#339933"),
    ("perl", "P", "#39457E"),
    ("php", "P", "#777BB4"),
    ("python", "\u03C0", "#FFD43B"),
    ("rlang", "R", "#276DC3"),
    ("ruby", "Rb", "#CC342D"),
    ("rust", "Rs", "#D34516"),
    ("scala", "Sc", "#DC322F"),
    ("swift", "\u2736", "#FA7343"),
    ("zig", "Z", "#F7A41D"),
]

# Build language format strings
lang_configs = []
for mod, logo, color in langs:
    lang_configs.append(f"""[{mod}]
symbol = "{logo}"
style = "bold fg:{color}"
format = "[$symbol$version]($style) "
""")

# Build the full config
config = f"""# tactical/starship.toml
# Dynamic config based on DMS theme (milkTheme)

format = \"\"\"
[{pipe_tl}{pipe_h}{pipe_h}](fg:{dms_colors['primaryContainer']})[$username](bold fg:{dms_colors['warning']})[─](fg:{dms_colors['primary']})[$hostname](bold fg:{dms_colors['info']})[─](fg:{dms_colors['primary']})[$directory](bold fg:{dms_colors['surfaceText']})[─](fg:{dms_colors['primary']})[$time](bold fg:{dms_colors['surfaceText']}) $git_branch$git_status $c$cpp$dart$deno$elixir$golang$haskell$java$julia$kotlin$lua$nodejs$perl$php$python$rlang$ruby$rust$scala$swift$zig
[{pipe_bl}{pipe_h}](fg:{dms_colors['primary']})$character\"\"\"

add_newline = true

[username]
style_user = "bold fg:{dms_colors['warning']}"
style_root = "bold fg:#ff0000"
show_always = true
format = "[$user]($style)"

[hostname]
style = "bold fg:{dms_colors['info']}"
ssh_only = false
format = "[@$hostname]($style)"

[directory]
style = "bold fg:{dms_colors['surfaceText']}"
truncation_length = 5
truncate_to_repo = true
format = "[$path]($style)"

[time]
disabled = false
time_format = "%H:%M"
style = "bold fg:{dms_colors['surfaceText']}"
format = "at [$time]($style) "

[git_branch]
style = "bold fg:{dms_colors['primary']}"
format = "[$symbol$branch]($style) "

[git_status]
style = "bold fg:{dms_colors['surfaceText']}"
format = '[$all_status$ahead_behind]($style) '

{"".join(lang_configs)}
[character]
success_symbol = "[❯](bold fg:#339933)"
error_symbol = "[❯](bold fg:#ff0000)"
vimcmd_symbol = "[❮](bold fg:{dms_colors['warning']})"
format = "$symbol "
"""

with open(os.path.expanduser("~/.config/tactical/starship.toml"), "w") as f:
    f.write(config)

print("Generated with DMS theme colors")
PYEOF
