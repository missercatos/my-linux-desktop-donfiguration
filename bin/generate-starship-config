#!/usr/bin/env bash
# Generate starship config based on cava theme colors

CAVA_CONFIG="$HOME/.config/cava/config"
CAVA_THEME_DIR="$HOME/.config/cava/themes"
STARSHIP_CONFIG="$HOME/.config/tactical/starship.toml"

# Read cava theme
if [[ -f "$CAVA_CONFIG" ]]; then
    THEME=$(grep "theme = " "$CAVA_CONFIG" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    if [[ -n "$THEME" && -f "$CAVA_THEME_DIR/$THEME" ]]; then
        CAVA_SRC="$CAVA_THEME_DIR/$THEME"
    else
        CAVA_SRC="$CAVA_CONFIG"
    fi
else
    echo "No cava config found, using defaults"
    CAVA_SRC=""
fi

# Extract colors from cava
if [[ -n "$CAVA_SRC" ]]; then
    COLOR1=$(grep "gradient_color_1" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR2=$(grep "gradient_color_2" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR3=$(grep "gradient_color_3" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
fi

# Defaults if colors not found
COLOR1="${COLOR1:-#52263e}"
COLOR2="${COLOR2:-#ac3232}"
COLOR3="${COLOR3:-#e6d4d8}"

# Calculate foreground colors (white or black based on background brightness)
hex_to_rgb() {
    local hex=$1
    local r=$((16#${hex:1:2}))
    local g=$((16#${hex:3:2}))
    local b=$((16#${hex:5:2}))
    echo "$r $g $b"
}

get_fg() {
    local hex=$1
    read r g b <<< $(hex_to_rgb "$hex")
    # Calculate brightness
    local brightness=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
    if [[ $brightness -gt 128 ]]; then
        echo "#000000"
    else
        echo "#ffffff"
    fi
}

FG1=$(get_fg "$COLOR1")
FG2=$(get_fg "$COLOR2")
FG3=$(get_fg "$COLOR3")

# Generate starship config
cat > "$STARSHIP_CONFIG" << EOF
# tactical/starship.toml - Dynamic config based on cava theme
# Auto-generated by generate-starship-config

format = """
┌──[$username](bold fg:$COLOR2)-[$hostname](bold fg:$COLOR3 dimmed)-[$directory](bold fg:$COLOR1)-[at \$time](bold fg:$COLOR3) \$git_branch\$git_status \$c\$cpp\$dart\$deno\$elixir\$golang\$haskell\$java\$julia\$kotlin\$lua\$nodejs\$perl\$php\$python\$rlang\$ruby\$rust\$scala\$swift\$zig
└─<\$character"""

add_newline = true

[username]
style_user = "bold fg:$COLOR3"
style_root = "bold fg:#ff0000"
show_always = true
format = "[\$user](\$style)"

[hostname]
style = "bold fg:$COLOR3 dimmed"
ssh_only = false
format = "[@\$hostname](\$style)"

[directory]
style = "bold fg:$COLOR1 bg:$COLOR2"
truncation_length = 5
truncate_to_repo = true
format = "[ \$path ](\$style)"

[time]
disabled = false
time_format = "%H:%M"
style = "bold fg:$FG2 bg:$COLOR2"
format = "[ at \$time ](\$style) "

[git_branch]
style = "bold fg:$COLOR1"
format = "[\$symbol\$branch](\$style) "

[git_status]
style = "bold fg:$COLOR3"
format = '[\$all_status\$ahead_behind](\$style) '

# Language modules - simple Nerd Font symbols
[c]
disabled = false
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[cpp]
disabled = false
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[dart]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[deno]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[elixir]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[golang]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[haskell]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[java]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[julia]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[kotlin]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[lua]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[nodejs]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[perl]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[php]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[python]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[rlang]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[ruby]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[rust]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[scala]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[swift]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[zig]
symbol = " "
style = "bold"
format = "[\$symbol\$version](\$style) "

[character]
success_symbol = "[❯](bold fg:$COLOR2)"
error_symbol = "[❯](bold fg:#ff0000)"
format = "\$symbol "
EOF

echo "Generated starship config with colors:"
echo "  COLOR1: $COLOR1"
echo "  COLOR2: $COLOR2"
echo "  COLOR3: $COLOR3"
