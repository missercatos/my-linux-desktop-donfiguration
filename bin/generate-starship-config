#!/usr/bin/env bash
# Generate starship config with cava theme colors and Nerd Font language logos
# Wrapper script that calls Python for proper Unicode handling

python3 << 'PYEOF'
import os

# Get cava colors
cava_file = os.path.expanduser("~/.config/cava/themes/your-theme")
colors = {"1": "#52263e", "2": "#ac3232", "3": "#e6d4d8"}

try:
    with open(cava_file) as f:
        for line in f:
            for i in ["1", "2", "3"]:
                if f"gradient_color_{i}" in line:
                    colors[i] = line.split("'")[1]
except:
    pass

c1, c2, c3 = colors["1"], colors["2"], colors["3"]

# Nerd Font symbols for languages
langs = [
    ("c", "C:", "\uf61e", c2),
    ("cpp", "C++:", "\uf61d", c1),
    ("dart", "Dart:", "\uf798", c1),
    ("deno", "Deno:", "\ue71e", c3),
    ("elixir", "Elixir:", "\ue71a", c1),
    ("golang", "Go:", "\uf627", c2),
    ("haskell", "Haskell:", "\ue777", c1),
    ("java", "Java:", "\uf738", c3),
    ("julia", "Julia:", "\ue724", c1),
    ("kotlin", "Kotlin:", "\ue634", c2),
    ("lua", "Lua:", "\ue620", c1),
    ("nodejs", "Node:", "\uf718", c2),
    ("perl", "Perl:", "\uf71f", c3),
    ("php", "PHP:", "\uf77d", c1),
    ("python", "Python:", "\uf73c", c2),
    ("rlang", "R:", "\uf75a", c1),
    ("ruby", "Ruby:", "\uf739", c3),
    ("rust", "Rust:", "\uf7a8", c2),
    ("scala", "Scala:", "\uf778", c1),
    ("swift", "Swift:", "\uf755", c3),
    ("zig", "Zig:", "\uf6a9", c2),
]

config = f"""# tactical/starship.toml - Dynamic config based on cava theme
# Auto-generated by generate-starship-config

format = \"\"\"
┌──[$username](bold fg:{c2})-[$hostname](bold fg:{c3} dimmed)-[$directory](bold fg:{c1})-[$time](bold fg:{c3}) $git_branch$git_status $c$cpp$dart$deno$elixir$golang$haskell$java$julia$kotlin$lua$nodejs$perl$php$python$rlang$ruby$rust$scala$swift$zig
└─<$character\"\"\"

add_newline = true

[username]
style_user = "bold fg:{c3}"
style_root = "bold fg:#ff0000"
show_always = true
format = "[$user]($style)"

[hostname]
style = "bold fg:{c3} dimmed"
ssh_only = false
format = "[@$hostname]($style)"

[directory]
style = "bold fg:{c1}"
truncation_length = 5
truncate_to_repo = true
format = "[$path]($style) "

[time]
disabled = false
time_format = "%H:%M"
style = "bold fg:{c3}"
format = "at [$time]($style) "

[git_branch]
style = "bold fg:{c2}"
format = "[$symbol$branch]($style) "

[git_status]
style = "bold fg:{c3}"
format = '[$all_status$ahead_behind]($style) '

"""

for mod, label, sym, color in langs:
    config += f"""[{mod}]
disabled = false
symbol = "{sym}"
style = "bold fg:{color}"
format = "[$symbol$version]($style) "

"""

config += f"""[character]
success_symbol = "[>](bold fg:{c2})"
error_symbol = "[>](bold fg:#ff0000)"
format = "$symbol "
"""

config_path = os.path.expanduser("~/.config/tactical/starship.toml")
with open(config_path, "w") as f:
    f.write(config)

print(f"Generated with cava colors: {c1} -> {c2} -> {c3}")
PYEOF
