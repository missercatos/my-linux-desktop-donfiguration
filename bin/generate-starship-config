#!/usr/bin/env bash
# Generate starship config with gradient blocks based on cava theme

CAVA_CONFIG="$HOME/.config/cava/config"
CAVA_THEME_DIR="$HOME/.config/cava/themes"
STARSHIP_CONFIG="$HOME/.config/tactical/starship.toml"

# Read cava theme
if [[ -f "$CAVA_CONFIG" ]]; then
    THEME=$(grep "theme = " "$CAVA_CONFIG" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    if [[ -n "$THEME" && -f "$CAVA_THEME_DIR/$THEME" ]]; then
        CAVA_SRC="$CAVA_THEME_DIR/$THEME"
    else
        CAVA_SRC="$CAVA_CONFIG"
    fi
else
    CAVA_SRC=""
fi

# Extract colors
if [[ -n "$CAVA_SRC" ]]; then
    COLOR1=$(grep "gradient_color_1" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR2=$(grep "gradient_color_2" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
    COLOR3=$(grep "gradient_color_3" "$CAVA_SRC" | head -1 | sed "s/.*= *'\(.*\)'/\1/")
fi

COLOR1="${COLOR1:-#52263e}"
COLOR2="${COLOR2:-#ac3232}"
COLOR3="${COLOR3:-#e6d4d8}"

# Calculate foreground colors
hex_to_rgb() {
    echo $((16#${1:1:2})) $((16#${1:3:2})) $((16#${1:5:2}))
}

get_fg() {
    read r g b <<< $(hex_to_rgb "$1")
    [[ $(( (r * 299 + g * 587 + b * 114) / 1000 )) -gt 128 ]] && echo "#000000" || echo "#ffffff"
}

FG1=$(get_fg "$COLOR1")
FG2=$(get_fg "$COLOR2")
FG3=$(get_fg "$COLOR3")

# Write starship config - use single-quoted heredoc to prevent bash expansion
# Then use envsubst or manual substitution for only the color variables
cat > "$STARSHIP_CONFIG" << 'STARSHIP_EOF'
# tactical/starship.toml - Dynamic gradient config based on cava theme
# Auto-generated by generate-starship-config

format = """
$username$hostname$directory $time $git_branch$git_status
$character"""

add_newline = true

[username]
style_user = "bold fg:__FG3__ bg:__COLOR3__"
format = "[ $user ]($style)"

[hostname]
style = "bold fg:__FG3__ bg:__COLOR3__"
ssh_only = false
format = "─[ @$hostname ]($style)"

[directory]
style = "bold fg:__FG2__ bg:__COLOR2__"
truncation_length = 5
truncate_to_repo = true
format = "─[ $path ]($style)"

[time]
disabled = false
time_format = "%H:%M"
style = "bold fg:__FG1__ bg:__COLOR1__"
format = "─[ $time ]($style)"

[git_branch]
style = "bold fg:__COLOR2__"
format = "─[ $symbol$branch ]($style)"

[git_status]
style = "bold fg:__COLOR3__"
format = '[ $all_status$ahead_behind ]($style)'

[c]
disabled = false
symbol = "C:"
style = "bold"
format = "[$symbol$version]($style) "

[cpp]
disabled = false
symbol = "C++:"
style = "bold"
format = "[$symbol$version]($style) "

[dart]
symbol = "Dart:"
style = "bold"
format = "[$symbol$version]($style) "

[deno]
symbol = "Deno:"
style = "bold"
format = "[$symbol$version]($style) "

[elixir]
symbol = "Elixir:"
style = "bold"
format = "[$symbol$version]($style) "

[golang]
symbol = "Go:"
style = "bold"
format = "[$symbol$version]($style) "

[haskell]
symbol = "Haskell:"
style = "bold"
format = "[$symbol$version]($style) "

[java]
symbol = "Java:"
style = "bold"
format = "[$symbol$version]($style) "

[julia]
symbol = "Julia:"
style = "bold"
format = "[$symbol$version]($style) "

[kotlin]
symbol = "Kotlin:"
style = "bold"
format = "[$symbol$version]($style) "

[lua]
symbol = "Lua:"
style = "bold"
format = "[$symbol$version]($style) "

[nodejs]
symbol = "Node:"
style = "bold"
format = "[$symbol$version]($style) "

[perl]
symbol = "Perl:"
style = "bold"
format = "[$symbol$version]($style) "

[php]
symbol = "PHP:"
style = "bold"
format = "[$symbol$version]($style) "

[python]
symbol = "Python:"
style = "bold"
format = "[$symbol$version]($style) "

[rlang]
symbol = "R:"
style = "bold"
format = "[$symbol$version]($style) "

[ruby]
symbol = "Ruby:"
style = "bold"
format = "[$symbol$version]($style) "

[rust]
symbol = "Rust:"
style = "bold"
format = "[$symbol$version]($style) "

[scala]
symbol = "Scala:"
style = "bold"
format = "[$symbol$version]($style) "

[swift]
symbol = "Swift:"
style = "bold"
format = "[$symbol$version]($style) "

[zig]
symbol = "Zig:"
style = "bold"
format = "[$symbol$version]($style) "

[character]
success_symbol = "[>](bold fg:__COLOR2__)"
error_symbol = "[>](bold fg:#ff0000)"
format = "$symbol "
STARSHIP_EOF

# Replace color placeholders with actual values
sed -i "s/__COLOR1__/$COLOR1/g" "$STARSHIP_CONFIG"
sed -i "s/__COLOR2__/$COLOR2/g" "$STARSHIP_CONFIG"
sed -i "s/__COLOR3__/$COLOR3/g" "$STARSHIP_CONFIG"
sed -i "s/__FG1__/$FG1/g" "$STARSHIP_CONFIG"
sed -i "s/__FG2__/$FG2/g" "$STARSHIP_CONFIG"
sed -i "s/__FG3__/$FG3/g" "$STARSHIP_CONFIG"

echo "Generated with gradient colors: $COLOR1 → $COLOR2 → $COLOR3"
