#!/usr/bin/env bash
# h - 工具大全速查手册
# 用法: h          显示所有工具分类
#       h -c <cmd> 显示指定命令详情
#       h -s <关键字> 搜索工具
#       h -l       仅列出命令名

set -euo pipefail

# ── 颜色定义 ──
R='\033[0;31m'  G='\033[0;32m'  Y='\033[1;33m'
B='\033[0;34m'  C='\033[0;36m'  M='\033[0;35m'
W='\033[1;37m'  D='\033[0;90m'  N='\033[0m'
BOLD='\033[1m'  DIM='\033[2m'

# ── 中文帮助文件目录 ──
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAN_ZH_DIR="${SCRIPT_DIR}/../share/man-zh"
if [[ ! -d "$MAN_ZH_DIR" ]]; then
    MAN_ZH_DIR="${HOME}/.local/share/man-zh"
fi
ZHELP_DIR="${HOME}/.local/share/zhhelp"
[[ ! -d "$ZHELP_DIR" ]] && ZHELP_DIR="${HOME}/.config/fish/zhhelp"

# ══════════════════════════════════════════
# 工具数据库 - 格式: "命令|简介|英文名"
# ══════════════════════════════════════════

declare -a CAT_NET=(
    "curl|URL数据传输|URL Transfer Tool"
    "wget|非交互式下载|Non-interactive Downloader"
    "aria2c|多协议下载|Multi-protocol Downloader"
    "arping|ARP层主机探测|ARP Ping"
    "traceroute|路由追踪|Trace Route"
)

declare -a CAT_REV=(
    "gdb|GNU调试器|GNU Debugger"
    "radare2|逆向工程框架|Reverse Engineering Framework"
    "r2|radare2别名|radare2 Alias"
    "rizin|逆向框架分支|Reverse Engineering Framework"
    "ghidra|NSA逆向套件|Software Reverse Engineering"
    "jadx|APK反编译|Dex to Java Decompiler"
    "binwalk|固件分析提取|Firmware Analysis Tool"
    "strings|提取可打印字符串|Print Strings"
    "objdump|目标文件反汇编|Object File Dump"
    "readelf|ELF文件解析|ELF File Reader"
    "ROPgadget|ROP链构造|ROP Gadget Finder"
    "rabin2|二进制信息提取|Binary Info Reader"
    "rz-bin|rizin二进制工具|Binary Tool"
    "pwn|pwntools框架|Pwn Tools"
    "ROPgadget|ROP链构造|ROP Gadget Finder"
)

declare -a CAT_WEB=(
    "sqlmap|SQL注入自动化|SQL Injection Tool"
)

declare -a CAT_PROTO=(
    "wireshark|网络协议分析|Network Protocol Analyzer"
    "tshark|终端抓包|Terminal Wireshark"
    "socat|双向数据流中继|Socket Relay"
    "smbclient|SMB/CIFS客户端|SMB Client"
    "rpcclient|RPC客户端|RPC Client"
)

declare -a CAT_CRYPTO=(
    "openssl|加密解密工具包|SSL/TLS Toolkit"
)

declare -a CAT_TRACE=(
    "strace|系统调用追踪|System Call Trace"
    "ltrace|库函数调用追踪|Library Call Trace"
    "file|文件类型识别|File Type Detector"
    "base64|Base64编解码|Base64 Encoder/Decoder"
)

declare -a CAT_MEDIA=(
    "ffmpeg|音视频转码剪辑|Multimedia Framework"
    "ffprobe|媒体文件信息|Media Analyzer"
    "ffplay|简易媒体播放器|Simple Media Player"
    "convert|ImageMagick图像处理|ImageMagick Convert"
    "magick|ImageMagick7命令|ImageMagick 7"
    "identify|图像格式识别|Image Identifier"
    "mpv|高性能视频播放器|Video Player"
    "jp2a|图片转ASCII艺术|JPEG to ASCII"
    "chafa|终端图像渲染|Terminal Image Viewer"
)

declare -a CAT_TERM=(
    "tmux|终端会话管理|Terminal Multiplexer"
    "btop|资源使用监控|Resource Monitor"
    "eza|现代化ls替代|Modern ls Replacement"
    "bat|带高亮的cat|Cat with Highlighting"
    "fzf|模糊查找|Fuzzy Finder"
    "jq|JSON命令行处理|JSON Processor"
    "tree|树形目录结构|Directory Tree"
    "ripgrep|高速正则搜索|Fast Regex Search"
    "fd|现代化find替代|Modern find Alternative"
)

declare -a CAT_VCS=(
    "git|分布式版本控制|Distributed Version Control"
    "gh|GitHub命令行工具|GitHub CLI"
)

declare -a CAT_DEV=(
    "docker|应用容器引擎|Container Engine"
    "docker-compose|多容器编排|Docker Compose"
    "cargo|Rust包管理|Rust Package Manager"
    "rustc|Rust编译器|Rust Compiler"
    "gcc|GNU编译器|GNU Compiler"
    "g++|C++编译器|GNU C++ Compiler"
    "make|构建自动化|Build Automation"
    "cmake|跨平台构建|Cross-platform Build"
    "node|Node.js运行时|Node.js Runtime"
    "npm|Node包管理|Node Package Manager"
    "python|Python解释器|Python Interpreter"
    "python3|Python3解释器|Python3 Interpreter"
)

declare -a CAT_PKG=(
    "pacman|Arch包管理|Arch Package Manager"
    "yay|AUR助手|AUR Helper"
    "paru|AUR助手|AUR Helper"
)

declare -a CAT_SYS=(
    "systemctl|系统服务管理|Systemd Service Control"
    "journalctl|系统日志查看|Systemd Journal"
)

declare -a CAT_AI=(
    "kd|命令行词典翻译|Command Dictionary"
    "dsh|DeepSeek Harness|DeepSeek Harness"
)

# ══════════════════════════════════════════
# 所有分类数组（用于搜索和遍历）
# ══════════════════════════════════════════
ALL_CATS=(
    "CAT_NET:网络传输"
    "CAT_REV:逆向分析"
    "CAT_WEB:Web渗透"
    "CAT_PROTO:协议分析"
    "CAT_CRYPTO:密码学"
    "CAT_TRACE:系统追踪"
    "CAT_MEDIA:音视频处理"
    "CAT_TERM:终端工具"
    "CAT_VCS:版本控制"
    "CAT_DEV:编程开发"
    "CAT_PKG:包管理"
    "CAT_SYS:系统管理"
    "CAT_AI:AI工具"
)

# ══════════════════════════════════════════
# 函数
# ══════════════════════════════════════════

print_category() {
    local arr_name="$1"
    local cat_name="$2"
    local -n tools="$arr_name"
    local count=${#tools[@]}

    echo -e "${BOLD}${C}═══════════════════════════════════════════════════════${N}"
    echo -e "${BOLD}${C}  分类: ${W}${cat_name}${N} ${D}(${count}个工具)${N}"
    echo -e "${BOLD}${C}═══════════════════════════════════════════════════════${N}"

    for entry in "${tools[@]}"; do
        IFS='|' read -r cmd desc en_name <<< "$entry"
        printf "  ${W}%-16s${N} ${D}[${cat_name}]${N} %s\n" "$cmd" "$desc"
    done
    echo ""
}

show_detail() {
    local cmd="$1"

    # 查找中文帮助文件
    local zh_file=""
    if [[ -f "${ZHELP_DIR}/${cmd}.txt" ]]; then
        zh_file="${ZHELP_DIR}/${cmd}.txt"
    elif [[ -f "${MAN_ZH_DIR}/ctf/${cmd}.zh.txt" ]]; then
        zh_file="${MAN_ZH_DIR}/ctf/${cmd}.zh.txt"
    elif [[ -f "${MAN_ZH_DIR}/tools/${cmd}.zh.txt" ]]; then
        zh_file="${MAN_ZH_DIR}/tools/${cmd}.zh.txt"
    fi

    echo -e "${BOLD}${C}═══════════════════════════════════════════════════════${N}"
    echo -e "${BOLD}${W}  命令: ${cmd}${N}"
    echo -e "${BOLD}${C}═══════════════════════════════════════════════════════${N}"

    # 显示中文帮助（优先）
    if [[ -n "$zh_file" ]]; then
        echo ""
        cat "$zh_file"
        echo ""
    fi

    # 显示英文原版帮助（作为补充）
    echo -e "${Y}── 英文帮助 ──${N}"
    if command -v "$cmd" &>/dev/null; then
        if "$cmd" -h &>/dev/null 2>&1; then
            "$cmd" -h 2>&1 | head -50
        elif "$cmd" --help &>/dev/null 2>&1; then
            "$cmd" --help 2>&1 | head -50
        else
            echo -e "${D}(无 -h/--help 输出)${N}"
        fi
    else
        echo -e "${D}(命令未安装)${N}"
    fi
    echo ""
}

search_tools() {
    local keyword="$1"
    echo -e "${BOLD}${C}搜索: ${keyword}${N}\n"

    local found=0
    for cat_info in "${ALL_CATS[@]}"; do
        IFS=':' read -r arr_name cat_name <<< "$cat_info"
        local -n tools="$arr_name"
        for entry in "${tools[@]}"; do
            if [[ "$entry" == *"$keyword"* ]]; then
                IFS='|' read -r cmd desc en_name <<< "$entry"
                printf "  ${W}%-16s${N} ${D}[${cat_name}]${N} %s (${en_name})\n" "$cmd" "$desc"
                found=1
            fi
        done
    done

    [[ $found -eq 0 ]] && echo -e "  ${D}未找到匹配的工具${N}"
}

list_commands() {
    for cat_info in "${ALL_CATS[@]}"; do
        IFS=':' read -r arr_name cat_name <<< "$cat_info"
        local -n tools="$arr_name"
        for entry in "${tools[@]}"; do
            IFS='|' read -r cmd desc en_name <<< "$entry"
            echo "$cmd"
        done
    done | sort
}

# ══════════════════════════════════════════
# 主逻辑
# ══════════════════════════════════════════

case "${1:-}" in
    -c|--cmd)
        [[ -z "${2:-}" ]] && { echo -e "${R}用法: h -c <命令名>${N}" >&2; exit 1; }
        show_detail "$2"
        exit 0
        ;;
    -s|--search)
        [[ -z "${2:-}" ]] && { echo -e "${R}用法: h -s <关键字>${N}" >&2; exit 1; }
        search_tools "$2"
        exit 0
        ;;
    -l|--list)
        list_commands
        exit 0
        ;;
    -h|--help)
        echo "用法: h [选项]"
        echo ""
        echo "选项:"
        echo "  (无参数)      显示所有工具分类速查"
        echo "  -c, --cmd     显示指定命令详情（中文帮助 + 英文帮助）"
        echo "  -s, --search  搜索工具"
        echo "  -l, --list    仅列出所有命令名"
        echo "  -h, --help    显示此帮助"
        echo ""
        echo "示例:"
        echo "  h              显示工具分类大全"
        echo "  h -c git       显示git的完整中文帮助"
        echo "  h -s 逆向      搜索含'逆向'的工具"
        echo "  h -l           列出所有命令名"
        exit 0
        ;;
esac

# ══════════════════════════════════════════
# 主显示 - 完全展开格式
# ══════════════════════════════════════════

echo -e "${BOLD}${C}╔══════════════════════════════════════════════════════════╗${N}"
echo -e "${BOLD}${C}║${N}  ${BOLD}${W}工具大全速查手册${N}  ${D}v2.0${N}                                ${C}║${N}"
echo -e "${BOLD}${C}╚══════════════════════════════════════════════════════════╝${N}"
echo ""

for cat_info in "${ALL_CATS[@]}"; do
    IFS=':' read -r arr_name cat_name <<< "$cat_info"
    print_category "$arr_name" "$cat_name"
done

echo -e "${D}──────────────────────────────────────────────────────────${N}"
echo -e "${D}用法: h -c <命令> 查看详情 | h -s <关键字> 搜索 | h -l 列出所有命令${N}"
